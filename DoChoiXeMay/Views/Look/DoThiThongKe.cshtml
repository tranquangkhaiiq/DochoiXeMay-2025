<style>
    .canvasjs-chart-credit {
        display: none;
    }
</style>
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
@if (@Session["Year"] != null)
{
    <input id="Yeardt" value="@Session["Year"].ToString()" hidden />
}
else
{
    <input id="Yeardt" value="" hidden />
}

<input id="phantramdaban" value="@ViewBag.phantramdaban" hidden />
<input id="phantramTraHangLeLoi" value="@ViewBag.phantramTraHangLeLoi" hidden />
<input id="phantramTongtraBH" value="@ViewBag.phantramTongtraBH" hidden />
@*<input id="phantramTonkho" value="@ViewBag.phantramTonkho" hidden />*@
<input id="phantramTonkhoT" value="@ViewBag.phantramTonkhoT" hidden />
<input id="phantramTonkhoK" value="@ViewBag.phantramTonkhoK" hidden />
<input id="phantramMauDaXuat" value="@ViewBag.phantramMauDaXuat" hidden />

<input id="DaSanXuat" value="@ViewBag.DaSanXuat" hidden />
<input id="daban" value="@ViewBag.daban" hidden />
<input id="TongtraBH" value="@Session["TongtraBH"].ToString()" hidden />

<input id="DaTraHangKhachLe" value="@ViewBag.DaTraHangKhachLe" hidden />
<input id="DaTraHangKhachLeLoi" value="@Session["DaTraHangKhachLeLoi"].ToString()" hidden />
@*<input id="TonKhoXiNhanGen1Tek" value="@Session["TonKhoXiNhanGen1Tek"].ToString()" hidden />*@
<input id="TonKhoXiNhanGen1TekT" value="@Session["TonKhoXiNhanGen1TekT"].ToString()" hidden />
<input id="TonKhoXiNhanGen1TekK" value="@Session["TonKhoXiNhanGen1TekK"].ToString()" hidden />
<input id="MauDaXuat" value="@Session["MauDaXuat"].ToString()" hidden />

@*27 tháng 11*@
<input id="TrongDaBanTikTok" value="@Session["TrongDaBanTikTok"].ToString()" hidden />
<input id="trongDaBanShopee" value="@Session["trongDaBanShopee"].ToString()" hidden />
<input id="trongDaBanLeNSan" value="@Session["trongDaBanLeNSan"].ToString()" hidden />
<input id="trongDaBanLSiNSan" value="@Session["trongDaBanLSiNSan"].ToString()" hidden />

<input id="KhoiDaBanTikTok" value="@Session["KhoiDaBanTikTok"].ToString()" hidden />
<input id="KhoiDaBanShopee" value="@Session["KhoiDaBanShopee"].ToString()" hidden />
<input id="KhoiDaBanLSiNSan" value="@Session["KhoiDaBanLSiNSan"].ToString()" hidden />
<input id="KhoiDaBanLeNSan" value="@Session["KhoiDaBanLeNSan"].ToString()" hidden />

<input id="DaBanLSiNSan" value="@ViewBag.DaBanLSiNSan" hidden />
<input id="DaBanTikTok" value="@ViewBag.DaBanTikTok" hidden />
<input id="DaBanShopee" value="@ViewBag.DaBanShopee" hidden />
<input id="DaBanLeNSan" value="@ViewBag.DaBanLeNSan" hidden />
@*11 tháng 2 năm 2026*@


<div id="chartContainer" style="height: 300px; width: 100%;"></div>
<div style="text-align:center">
    <h5 style="background-color:black;color:white">Khách lẻ trả hàng không lỗi @Session["Year"]: @ViewBag.DaTraHangKhachLe</h5>
    <h4 style="background-color:brown;color:white">Đại Lý gửi hàng Lỗi BH @Session["Year"]: @ViewBag.DaNhanHangDaiLyLoi</h4>
    <h4 style="background-color:brown;color:white">Đã trả BH cho đại lý @Session["Year"]: @ViewBag.DaGuiHangBHDaiLy</h4>
    <h4>Hàng Không Lỗi ==> đưa vào tồn kho, sử dụng lại.</h4>
</div>
<div id="chartContainer3" style="height: 300px; width: 100%;margin-top:30px"></div>
<div id="chartContainer4" style="height: 300px; width: 100%;margin-top:30px"></div>
<script>
    DothiXN();
    function DothiXN() {
        const CDaSanXuat = $("#DaSanXuat").val()
        const Cdaban = $("#daban").val()
        const CTongtraBH = $("#TongtraBH").val()
        const CDaTraHangKhachLeLoi = $("#DaTraHangKhachLeLoi").val()
        const CTonKhoXiNhanGen1TekT = $("#TonKhoXiNhanGen1TekT").val()
        const CTonKhoXiNhanGen1TekK = $("#TonKhoXiNhanGen1TekK").val()
        const CMauDaXuat = $("#MauDaXuat").val()
        const CYeardt = $("#Yeardt").val()

        const daban = $("#phantramdaban").val().replace(',', '.')
        const tdaban = parseFloat(daban).toFixed(2);
        var TraHangLeLoi = $("#phantramTraHangLeLoi").val().replace(',', '.')
        var tTraHangLeLoi = parseFloat(TraHangLeLoi)
        var traBH = $("#phantramTongtraBH").val().replace(',', '.')
        var ttraBH = parseFloat(traBH)
        var TonkhoT = $("#phantramTonkhoT").val().replace(',', '.')
        var tTonkhoT = parseFloat(TonkhoT)
        var TonkhoK = $("#phantramTonkhoK").val().replace(',', '.')
        var tTonkhoK = parseFloat(TonkhoK)
        var MauDaXuat = $("#phantramMauDaXuat").val().replace(',', '.')
        var tMauDaXuat = parseFloat(MauDaXuat)

        var chart = new CanvasJS.Chart("chartContainer", {
            animationEnabled: true,
            title: {
                text: "Wave TNT BLOCKX G2 ZEN 1 đã sản xuất " + CYeardt + ": " + CDaSanXuat
            },
            data: [{
                type: "pie",
                startAngle: 240,
                yValueFormatString: "##0.00\"%\"",
                indexLabel: "{label} {y}",
                dataPoints: [
                    { y: tdaban, label: "Da Ban " + CYeardt + " (" + Cdaban + ")" },
                    { y: tTraHangLeLoi, label: "KhachLeTraHangLoi " + CYeardt + " (" + CDaTraHangKhachLeLoi + ")" },
                    { y: ttraBH, label: "Tra BH KhachLe " + CYeardt + " (" + CTongtraBH + ")" },
                    { y: tTonkhoT, label: "Tonkho Trong (" + CTonKhoXiNhanGen1TekT + ")" },
                    { y: tTonkhoK, label: "Tonkho Khói (" + CTonKhoXiNhanGen1TekK + ")" },
                    { y: tMauDaXuat, label: "Hang Mau " + CYeardt + " (" + CMauDaXuat + ")" }
                ]
            }]
        });
        chart.render();

        const trongTikTok = $("#TrongDaBanTikTok").val()
        var ttrongTikTok = parseInt(trongTikTok);
        const trongShopee = $("#trongDaBanShopee").val()
        var ttrongShopee = parseInt(trongShopee);
        const trongLeNSan = $("#trongDaBanLeNSan").val()
        var ttrongLeNSan = parseInt(trongLeNSan);
        const trongSiNSan = $("#trongDaBanLSiNSan").val()
        var ttrongSiNSan = parseInt(trongSiNSan);

        const khoiTikTok = $("#KhoiDaBanTikTok").val()
        var tkhoiTikTok = parseInt(khoiTikTok);
        const khoiShopee = $("#KhoiDaBanShopee").val()
        var tkhoiShopee = parseInt(khoiShopee);
        const khoiSiNSan = $("#KhoiDaBanLSiNSan").val()
        var tkhoiSiNSan = parseInt(khoiSiNSan);
        const khoiLeNSan = $("#KhoiDaBanLeNSan").val()
        var tkhoiLeNSan = parseInt(khoiLeNSan);

        const DaBanTikTok = $("#DaBanTikTok").val()
        const DaBanShopee = $("#DaBanShopee").val()
        const DaBanLSiNSan = $("#DaBanLSiNSan").val()
        const DaBanLeNSan = $("#DaBanLeNSan").val()

        var chart3 = new CanvasJS.Chart("chartContainer3", {
            exportEnabled: true,
            animationEnabled: true,
            title: {
                text: "TNT BLOCKX G2 ZEN 1 Da Ban " + CYeardt + ": " + Cdaban
            },
            subtitles: [{
                text: "Trong: Blue  -  Khoi: Red"
            }],
            axisX: {
                title: ""
            },
            axisY: {
                title: "ZEN 1 - Trong",
                titleFontColor: "#4F81BC",
                lineColor: "#4F81BC",
                labelFontColor: "#4F81BC",
                tickColor: "#4F81BC",
                includeZero: true
            },
            axisY2: {
                title: "ZEN 1 - Khoi",
                titleFontColor: "#C0504E",
                lineColor: "#C0504E",
                labelFontColor: "#C0504E",
                tickColor: "#C0504E",
                includeZero: true
            },
            toolTip: {
                shared: true
            },
            legend: {
                cursor: "pointer",
                itemclick: toggleDataSeries
            },
            data: [{
                type: "column",
                name: "Trong",
                showInLegend: true,
                yValueFormatString: "#,##0.#",
                dataPoints: [
                    { label: "LeNSan " + CYeardt + " (" + DaBanLeNSan + ")", y: ttrongLeNSan },

                    { label: "Shopee " + CYeardt + " (" + DaBanShopee + ")", y: ttrongShopee },
                    { label: "TikTok " + CYeardt + " (" + DaBanTikTok + ")", y: ttrongTikTok },
                    { label: "SiNSan " + CYeardt + " (" + DaBanLSiNSan + ")", y: ttrongSiNSan },
                    //{ label: "Massachusetts", y: 28234 }
                ]
            },
            {
                type: "column",
                name: "Khoi",
                //axisYType: "secondary",
                showInLegend: true,
                yValueFormatString: "#,##0.#",
                dataPoints: [
                    { label: "LeNSan " + CYeardt + " (" + DaBanLeNSan + ")", y: tkhoiLeNSan },

                    { label: "Shopee " + CYeardt + " (" + DaBanShopee + ")", y: tkhoiShopee },
                    { label: "TikTok " + CYeardt + " (" + DaBanTikTok + ")", y: tkhoiTikTok },
                    { label: "SiNSan " + CYeardt + " (" + DaBanLSiNSan + ")", y: tkhoiSiNSan },
                    //{ label: "Massachusetts", y: 528 }
                ]
            }]
        });
        chart3.render();

        function toggleDataSeries(e) {
            if (typeof (e.dataSeries.visible) === "undefined" || e.dataSeries.visible) {
                e.dataSeries.visible = false;
            } else {
                e.dataSeries.visible = true;
            }
            e.chart3.render();
        }
        ///11thang2 năm 2026
        const YearHT = @Session["YearHT"].ToString();
        const YearC = @Session["YearC"].ToString();
        var chart4 = new CanvasJS.Chart("chartContainer4", {
            exportEnabled: true,
            animationEnabled: true,
            title: {
                text: "Thống Kê TNT BLOCKX G2 ZEN 1 Theo Tháng " + YearC + " - " + YearHT
            },
            subtitles: [{
                text: YearC + ": Blue  -  " + YearHT +": Red"
            }],
            axisX: {
                title: ""
            },
            axisY: {
                title: "ZEN 1 - " + YearC,
                titleFontColor: "#4F81BC",
                lineColor: "#61bc4f",
                labelFontColor: "#61bc4f",
                tickColor: "#4F81BC",
                includeZero: true
            },
            axisY2: {
                title: "ZEN 1 - " + YearHT,
                titleFontColor: "#C0504E",
                lineColor: "#C0504E",
                labelFontColor: "#C0504E",
                tickColor: "#C0504E",
                includeZero: true
            },
            toolTip: {
                shared: true
            },
            legend: {
                cursor: "pointer",
                itemclick: toggleDataSeries
            },
            data: [{
                type: "column",
                name: YearC+"",
                showInLegend: true,
                yValueFormatString: "#,##0.#",
                dataPoints: [
                    { label: YearC + "-Th1-" + YearHT, y: @Session["DaBantc1"] },

                    { label: "-Th2-", y: @Session["DaBantc2"] },
                    { label: "-Th3-", y: @Session["DaBantc3"] },
                    { label: "-Th4-", y: @Session["DaBantc4"] },
                    { label: "-Th5-", y: @Session["DaBantc5"] },
                    { label: "-Th6-", y: @Session["DaBantc6"] },
                    { label: "-Th7-", y: @Session["DaBantc7"] },
                    { label: "-Th8-", y: @Session["DaBantc8"] },
                    { label: "-Th9-", y: @Session["DaBantc9"] },
                    { label: "-Th10-", y: @Session["DaBantc10"] },
                    { label: "-Th11-", y: @Session["DaBantc11"] },
                    { label: YearC + "-Th12-" + YearHT, y: @Session["DaBantc12"] },
                ]
            },
            {
                type: "column",
                name: YearHT+"",
                //axisYType: "secondary",
                showInLegend: true,
                yValueFormatString: "#,##0.#",
                dataPoints: [
                    { label: YearC + "-Th1-" + YearHT, y: @Session["DaBantht1"] },
                    { label: "-Th2-", y: @Session["DaBantht2"] },
                    { label: "-Th3-", y: @Session["DaBantht3"] },
                    { label: "-Th4-", y: @Session["DaBantht4"] },
                    { label: "-Th5-", y: @Session["DaBantht5"] },
                    { label: "-Th6-", y: @Session["DaBantht6"] },
                    { label: "-Th7-", y: @Session["DaBantht7"] },
                    { label: "-Th8-", y: @Session["DaBantht8"] },
                    { label: "-Th9-", y: @Session["DaBantht9"] },
                    { label: "-Th10-", y: @Session["DaBantht10"] },
                    { label: "-Th11-", y: @Session["DaBantht11"] },
                    { label: YearC + "-Th12-" + YearHT, y: @Session["DaBantht12"] },
                ]
            }]
        });
        chart4.render();

        function toggleDataSeriess(e) {
            if (typeof (e.dataSeries.visible) === "undefined" || e.dataSeries.visible) {
                e.dataSeries.visible = false;
            } else {
                e.dataSeries.visible = true;
            }
            e.chart4.render();
        }
    }
</script>

