<div class="" style="width:100%;background-color: white; margin-top: 80px; border-radius: 4px 4px; box-shadow: 0px 2px 4px 0px rgba(0,0,0,0.32)">
    <div class="row" style="text-align: center !important; font-size: 30px; text-decoration:underline">
        <a href="/Admin/ChiNhanh/Index" target="_blank">Danh Sách Đơn Bán Sỉ TeK</a>
    </div>
    <h3 style="text-align:center;margin-bottom:20px"><a style="text-decoration: none">Danh Sách sản phẩm xuất/nhập TeK</a></h3>
    <h5 style="text-align:center;margin-bottom:20px"><a style="text-decoration: none">(Chỉ Xem - Muốn update thì vào admin)</a></h5>
    <div class="row">
        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-6" style="margin-top: 10px">
            <span style="margin-left:10px; color:brown">Tồn Kho 311 TNT BLOCKX G2 ZEN 1-Trong: @ViewBag.TrongTon311</span>
        </div>
        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-0" style="margin-top: 10px">
            <span style="margin-left:10px; color:blue">XiNhan G2 ZEN 1-Trong(Chưa Vô Hộp): @ViewBag.TrongTonChuaVoHop</span>
        </div>
        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-6" style="margin-top: 10px">
            <span style="margin-left: 10px; color: red ">Tồn Kho Hưng_HN TNT BLOCKX G2 ZEN 1-Trong: @ViewBag.TrongTonKho2</span>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-6" style="margin-top: 10px">
            <span style="margin-left: 10px; color: brown ">Tồn Kho 311 TNT BLOCKX G2 ZEN 1-Khói: @ViewBag.KhoiTon311</span>
        </div>
        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-0" style="margin-top: 10px">
            <span style="margin-left:10px; color:blue">XiNhan G2 ZEN 1-Khói(Chưa Vô Hộp): @ViewBag.KhoiTonChuaVoHop</span>
        </div>
        <div class="col-lg-4 col-xl-4 col-md-4 col-sm-6" style="margin-top: 10px">
            <span style="margin-left: 10px; color: red ">Tồn Kho Hưng_HN TNT BLOCKX G2 ZEN 1-Khói: @ViewBag.KhoiTonKho2</span>
        </div>
    </div>
    <div class="panel panel-default" style="margin-top:10px">
        <div class="panel-heading">
            <div class="row">
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-4" style="text-align: center; margin-top: 15px">
                    <span class="icon-case"><i class="glyphicon glyphicon-calendar"></i></span>
                    <input type="date" name="tungay" id="tungay" />
                </div>
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-4" style="text-align:center;margin-top:10px">
                    @Html.DropDownList("IdLoaiHangXN", null, new { style = "width: 70%; height: 40px" })
                </div>
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-4" style="text-align: center; margin-top: 10px">
                    @Html.DropDownList("IdSan", null, new { style = "width: 70%; height: 40px" })
                </div>
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-4" style="text-align: center; margin-top: 10px">
                    <select class="form-control" id="IdDoiTra" name="IdDoiTra" style="width: 70%; height: 40px; margin: 0 auto">
                        <option value="0">Loại sản phẩm</option>
                        <option value="2">Trả (Mới Nhận)</option>
                        <option value="3">Trả Có Lỗi</option>
                        <option value="4">Trả Không Lỗi</option>
                    </select>
                </div>
                <div class="col-lg-4 col-xl-4 col-md-4 col-sm-4 col-3" style="text-align: center; margin-top: 10px">
                    <input type="text" class="form-control input-sm" style="font-size: medium; height: 40px; width: 95%" name="KeywordsTT" id="KeywordsTT" onchange="TimKiemKyXN()" placeholder="Tên Kỳ hoặc số Serial." />
                </div>
            </div>
        </div>
        <div class="panel-body">
            <img id="loading" hidden src="~/Areas/Admin/Content/img/loading.gif" />
            <div class="listSPXNTEK">


            </div>
        </div>
        <div class="panel-footer">

            <div class="row">
                <div class="col-md-8">
                    <span class="TongSanPham"></span>
                </div>
                <div class="col-md-4" style="text-align: right">
                    <span class="TongSanPham"></span>
                </div>
            </div>


            <ul class="pager">
                <li><a href="#"><span class="glyphicon glyphicon-step-backward"></span></a></li>
                <li><a href="#"><span class="glyphicon glyphicon-chevron-left"></span></a></li>
                <li><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></li>
                <li><a href="#"><span class="glyphicon glyphicon-step-forward"></span></a></li>
            </ul>

        </div>
    </div>
</div>
@*<script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>*@
<script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<script>
    LoadPartime();
    
    $(function () {
        pageNo = 0;
        pageSize = 5;
        TongSP = 0;
        var KeywordsTT = $('#KeywordsTT').val();
        var YearXiNhan = $('#YearXiNhan').val();
        LoadLoaiKyXN()
        LoadSanTMDT()
        var UserId = 0;
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
        LoadPagedothi(YearXiNhan)
        $(".pager a:eq(0)").click(function () {
            if (pageNo > 0) {
                pageNo = 0;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = 0;
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false;
        });
        $(".pager a:eq(1)").click(function () {
            if (pageNo > 0) {
                pageNo--;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = 0;
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false;
        });
        $(".pager a:eq(2)").click(function () {
            if (pageNo < pageCount - 1) {
                pageNo++;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = 0;
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false;
        });

        $(".pager a:eq(3)").click(function () {
            if (pageNo < pageCount - 1) {
                pageNo = pageCount - 1;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = 0;
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false
        });
        
        ///////////////////////
    });
    
    function LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra) {
        $.ajax({
            url: "/Look/GetListKyXNTeK",
            data: { ngay: tungay, strk: KeywordsTT, idLHXN: idLoaiHangXN, IdSan: IdSan, Iddoitra: IdDoiTra, PageNo: pageNo, PageSize: pageSize, UserId: UserId },
            success: function (respone) {
                $(".listSPXNTEK").html(respone);
                var pagesp = pageNo + 1;
                $('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            },
            error: function (ex) {
                alert('Lỗi load KyXN: ' + ex);
            }
        });
    };
    function LoadPagedothi(YearXiNhan) {
        $.ajax({
            url: "/Look/DoThiThongKe",
            data: { nam: YearXiNhan },
            success: function (res) {
                $(".DoThiTK").html(res);
            }
        });
    }
    function getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra) {
        $.ajax({
            url: "/Look/GetPageCountXNTek",
            data: { ngay: tungay, strk: KeywordsTT, idLHXN: idLoaiHangXN, IdSan: IdSan, Iddoitra: IdDoiTra, PageSize: pageSize, UserId: UserId },
            success: function (respone) {
                pageCount = respone;
                TongSP = respone;
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
                
            }
        });
    };
    $("#IdLoaiHangXN").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = 0;
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
    });
    $("#IdSan").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = 0;
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
    });
    $("#IdDoiTra").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = 0;
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        $("#loading").show();
        $(".listSPXNTEK").css('display', 'none');
        setTimeout(function () {
            $(".listSPXNTEK").css('display', 'block');
            getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            //1s sau hiên lên
        }, 800);
        $("#loading").hide();
    });
    $("#tungay").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = 0;
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
    });
    ////
    $("#YearXiNhan").change(function () {
        var YearXiNhan = $('#YearXiNhan').val();
        LoadPagedothi(YearXiNhan);
    });
    ////
    function TimKiemKyXN() {
        pageNo = 0;
        pageSize = 5;
        TongSP = 0;
        var KeywordsTTT = $('#KeywordsTT').val();
        var UserId = 0;
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        $("#loading").show();
        $(".listSPXNTEK").css('display', 'none');

        setTimeout(function () {
            $(".listSPXNTEK").css('display', 'block');
            getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTTT, idLoaiHangXN, IdSan, IdDoiTra);
            //1s sau hiên lên
        }, 800);
        $("#loading").hide();
    };
    function LoadLoaiKyXN() {
        $('#IdLoaiHangXN').empty();
        $.ajax({
            url: "/Look/LoadLoaiKyXN", // we are calling json method
            data: {},
            success: function (response) {
                $("#IdLoaiHangXN").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Loại Kỳ XN")
                );
                $(response).each(function (i, e) {
                    $("#IdLoaiHangXN").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load User: ' + ex);
            }
        });

    };

    function LoadSanTMDT() {
        $('#IdSan').empty();
        $.ajax({
            url: "/Look/LoadSanTM", // we are calling json method
            data: {},
            success: function (response) {
                $("#IdSan").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Chọn Sàn TM")
                );
                $(response).each(function (i, e) {
                    $("#IdSan").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load User: ' + ex);
            }
        });

    };
    function LoadPartime() {
        GetListTinhGio()
        GetListTuan()
        $(".canvasjs-chart-credit").css("display", "none");
    }

    function GetListTinhGio() {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        $.ajax({
            url: "/Look/GetListTinhGioCong",
            data: { dtInput: tn, Id: Idnv },
            success: function (respone) {
                $(".listGioCongNV").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
    $("#ThangNam").change(function () {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        GetListTinhGio();
    });
    $("#Idnhanvien").change(function () {
        var tn = $('#ThangNam').val();
        var Idnv = $('#Idnhanvien').val();
        GetListTinhGio();
    });
    function GetListTuan() {
        var week = $('#SelectW').val();
        $.ajax({
            url: "/Look/GetListTuan",
            data: { tuanht: week },
            success: function (respone) {
                $(".listLichTuanNV").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }, error: function (err) {
                console.log(err, ':Loi get List');
            }
        });
    }
    $("#SelectW").change(function () {
        var week = $('#SelectW').val();
        GetListTuan();
    });
</script>
