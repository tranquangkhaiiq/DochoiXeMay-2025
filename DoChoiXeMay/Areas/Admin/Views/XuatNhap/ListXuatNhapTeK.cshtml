
@{
    ViewBag.Title = "ListXuatNhapTeK";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}
<div class="row">
    <div class="Title_Notin" style="text-align:center">
        <span class="">Bảng Xuất Nhập TeK</span>
    </div>
</div>
<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<style>
    .canhgiua {
        text-align: center !important;
    }
    .marginbutonkh {
        margin-top: 50%;
    }
</style>
<div class="row">
    <div class="col-lg-4 col-xl-4 col-md-4 col-sm-12" style="margin-top: 10px">
        <span style="margin-left:20px; color:brown">Tồn Kho TNT BLOCKX G2 ZEN 1-Trong: @ViewBag.TrongTon</span>
    </div>
    <div class="col-lg-4 col-xl-4 col-md-4 col-sm-12" style="margin-top: 10px">

    </div>
    <div class="col-lg-4 col-xl-4 col-md-4 col-sm-12" style="margin-top: 10px">
        <span style="margin-left: 20px; color: brown ">Tồn Kho TNT BLOCKX G2 ZEN 1-Khói: @ViewBag.KhoiTon</span>
    </div>
</div>
<div class="row">
    <div class="col-lg-4 col-xl-4 col-md-4 col-sm-12" style="margin-top: 10px">
        <span style="margin-left: 20px; color: darkgreen">Tồn Kho Viber-Trong: @ViewBag.TrongVibeTon</span>
    </div>
    <div class="col-lg-4 col-xl-4 col-md-4 col-sm-12" style="margin-top: 10px">

    </div>
    <div class="col-lg-4 col-xl-4 col-md-4 col-sm-12" style="margin-top: 10px">
        <span style="margin-left: 20px; color: darkgreen ">Tồn Kho Viber-Khói: @ViewBag.KhoiVibeTon</span>
    </div>
</div>
<div class="panel panel-default" style="margin-top:10px">
    <div class="panel-heading">
        <div class="row">
            <div class="pull-right label label-success" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongBaoXuatNhapTeK"]
            </div>
            <div class="pull-right label label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongBaoXuatNhapTeKct"]
            </div>
            <div class="row">
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-6" style="text-align: center; margin-top: 10px">
                    @Html.DropDownList("UserId", null, new { style = "width: 70%; height: 40px" })
                </div>
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-6 col-6" style="text-align: center; margin-top: 15px">
                    <span class="icon-case"><i class="glyphicon glyphicon-calendar"></i></span>
                    <input type="date" name="tungay" id="tungay" />
                </div>
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-6" style="text-align:center;margin-top:10px">
                    @Html.DropDownList("IdLoaiHangXN", null, new { style = "width: 70%; height: 40px" })
                </div>
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-6" style="text-align: center; margin-top: 10px">
                    @Html.DropDownList("IdSan", null, new { style = "width: 70%; height: 40px" })
                </div>
                <div class="col-lg-2 col-xl-2 col-md-2 col-sm-6" style="text-align: center; margin-top: 10px">
                    <select class="form-control" id="IdDoiTra" name="IdDoiTra" style="width: 70%; height: 40px; margin: 0 auto">
                        <option value="0">Loại sản phẩm</option>
                        <option value="2">Trả (Mới Nhận)</option>
                        <option value="3">Trả Có Lỗi</option>
                        <option value="4">Trả Không Lỗi</option>
                    </select>
                </div>
                <div class="col-lg-2 col-xl-4 col-md-2 col-sm-6" style="text-align:center">
                    <input type="text" class="form-control input-sm" style="font-size: medium; height: 40px; width: 95%" name="KeywordsTT" id="KeywordsTT" onchange="TimKiemKyXN()" placeholder="Tên Kỳ hoặc số Serial." />
                </div>
            </div>
            
        </div>
    </div>
    <div class="panel-body">
        <img id="loading" hidden src="~/Areas/Admin/Content/img/loading.gif" />
        <div class="listXNT">


        </div>
    </div>
    <div class="panel-footer">

        <div class="row">
            <div class="col-md-8">
                <span class="TongSanPham"></span>
            </div>
            <div class="col-md-4" style="text-align: right">
                <span class="TongSanPham"></span>
            </div>
        </div>


        <ul class="pager">
                <li><a href="#"><span class="glyphicon glyphicon-step-backward"></span></a></li>
                <li><a href="#"><span class="glyphicon glyphicon-chevron-left"></span></a></li>
                <li><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></li>
                <li><a href="#"><span class="glyphicon glyphicon-step-forward"></span></a></li>
            </ul>

    </div>
</div>
<h5>***Nếu Chưa đẩy lên Tek thì cho "update", đẩy rồi thì phải "yêu cầu Thu Hồi"</h5>
<h5>**Tổng tiền: Soluong*gianhap + shipper + VAT - ChietKhau% - ChietKhautienmat</h5>
<h5>**Chuyển Kho: gồm 1 kỳ xuất kho THIS (trừ ) && 1 kỳ nhập kho THAT (cộng)</h5>
<script>
    $(function () {
        pageNo = 0;
        pageSize = 5;
        TongSP = 0;
        var KeywordsTT = $('#KeywordsTT').val();
        LoadUserName()
        LoadLoaiKyXN()
        LoadSanTMDT()
        var UserId = $('#UserId').val();
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
        $(".pager a:eq(0)").click(function () {
            if (pageNo > 0) {
                pageNo = 0;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = $('#UserId').val();
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false;
        });
        $(".pager a:eq(1)").click(function () {
            if (pageNo > 0) {
                pageNo--;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = $('#UserId').val();
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false;
        });
        $(".pager a:eq(2)").click(function () {
            if (pageNo < pageCount - 1) {
                pageNo++;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = $('#UserId').val();
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false;
        });

        $(".pager a:eq(3)").click(function () {
            if (pageNo < pageCount - 1) {
                pageNo = pageCount - 1;
                var KeywordsTT = $('#KeywordsTT').val();
                var UserId = $('#UserId').val();
                var idLoaiHangXN = $('#IdLoaiHangXN').val();
                var IdSan = $('#IdSan').val();
                var IdDoiTra = $('#IdDoiTra').val();
                var tungay = $('#tungay').val();
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
            return false
        });
    });
    $("#UserId").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = $('#UserId').val();
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
    });
    $("#IdLoaiHangXN").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = $('#UserId').val();
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
    });
    $("#IdSan").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = $('#UserId').val();
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
    });
    $("#IdDoiTra").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = $('#UserId').val();
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        $("#loading").show();
        $(".listXNT").css('display', 'none');
        setTimeout(function () {
            $(".listXNT").css('display', 'block');
            getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            //1s sau hiên lên
        }, 800);
        $("#loading").hide();
    });
    $("#tungay").change(function () {
        pageNo = 0;
        pageSize = 5;
        var KeywordsTT = $('#KeywordsTT').val();
        var UserId = $('#UserId').val();
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra)
    });
    function LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra) {
        $.ajax({
            url: "/Admin/XuatNhap/GetListKyXNTeK",
            data: { ngay: tungay, strk: KeywordsTT, idLHXN: idLoaiHangXN, IdSan: IdSan, Iddoitra: IdDoiTra, PageNo: pageNo, PageSize: pageSize, UserId: UserId },
            success: function (respone) {
                $(".listXNT").html(respone);
                var pagesp = pageNo + 1;
                $('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }
        });
    };
    function getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra) {
        $.ajax({
            url: "/Admin/XuatNhap/GetPageCountXNTek",
            data: { ngay: tungay, strk: KeywordsTT, idLHXN: idLoaiHangXN, IdSan: IdSan, Iddoitra: IdDoiTra, PageSize: pageSize, UserId: UserId },
            success: function (respone) {
                pageCount = respone;
                TongSP = respone;
                LoadPage(tungay, pageNo, pageSize, UserId, KeywordsTT, idLoaiHangXN, IdSan, IdDoiTra);
            }
        });
    };
    function TimKiemKyXN() {
        pageNo = 0;
        pageSize = 5;
        TongSP = 0;
        var KeywordsTTT = $('#KeywordsTT').val();
        var UserId = $('#UserId').val();
        var idLoaiHangXN = $('#IdLoaiHangXN').val();
        var IdSan = $('#IdSan').val();
        var IdDoiTra = $('#IdDoiTra').val();
        var tungay = $('#tungay').val();
        $("#loading").show();
        $(".listXNT").css('display', 'none');

        setTimeout(function () {
            $(".listXNT").css('display', 'block');
            getTongSanPham(tungay, pageSize, pageNo, UserId, KeywordsTTT, idLoaiHangXN, IdSan, IdDoiTra);
            //1s sau hiên lên
        }, 800);
        $("#loading").hide();
    };
    function LoadUserName() {
        $('#UserId').empty();
        $.ajax({
            url: "/Admin/XuatNhap/LocUserName", // we are calling json method
            data: {},
            success: function (response) {
                $("#UserId").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Chọn User")
                );
                $(response).each(function (i, e) {
                    $("#UserId").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load User: ' + ex);
            }
        });
        
    };
    function LoadLoaiKyXN() {
        $('#IdLoaiHangXN').empty();
        $.ajax({
            url: "/Admin/XuatNhap/LoadLoaiKyXN", // we are calling json method
            data: {},
            success: function (response) {
                $("#IdLoaiHangXN").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Loại Kỳ XN")
                );
                $(response).each(function (i, e) {
                    $("#IdLoaiHangXN").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load User: ' + ex);
            }
        });

    };

    function LoadSanTMDT() {
        $('#IdSan').empty();
        $.ajax({
            url: "/Admin/XuatNhap/LoadSanTM", // we are calling json method
            data: {},
            success: function (response) {
                $("#IdSan").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Chọn Sàn TM")
                );
                $(response).each(function (i, e) {
                    $("#IdSan").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load User: ' + ex);
            }
        });

    };

</script>
