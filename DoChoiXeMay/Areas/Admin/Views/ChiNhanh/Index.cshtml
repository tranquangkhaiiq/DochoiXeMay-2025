
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}

<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<style>
    .canhgiua {
        text-align: center !important;
    }
</style>
<div>
    <div class="row">
        <div class="Title_Notin" style="text-align:center">
            <span class="">List Xuất S/N cho Chi Nhánh</span>
        </div>
    </div>
    <div class="panel panel-default" style="margin-top:10px">
        <div class="panel-heading">
            <div class="row">
                <div class="col-md-4">
                    <h5>***Nếu chuyển kho == true ==> Chọn kho đích đến***</h5>
                </div>
                <div class="col-md-8">
                    <div class="row">
                        <div class="pull-right label label-primary" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                            @Session["ThongBaoXuatSN_ChiNhanh"]
                        </div>
                    </div>
                    <div class="row">
                        <div class="pull-right label label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                            @Session["ThongBaoLoiSN_ChiNhanh"]
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" style="margin-top:5px">

                <div class="col-md-2" style="text-align:left">
                    @if (Session["quyen"] != null && int.Parse(Session["quyen"].ToString()) < 5)
                    {
                        <a class="btn btn-warning" style="height:40px" href="/Admin/ChiNhanh/InsertAutoSNChiNhanh" onclick="return confirm('Bạn muốn Thêm Mới S/N cho Chi Nhánh ??')">
                            <i class="fa fa-plus-circle"></i>&nbsp;&nbsp; Tạo lô hàng gửi chi nhánh
                        </a>
                    }
                    else
                    {
                        <span>Hiển thị 40 đơn gần nhất</span>
                    }

                </div>
                <div class="col-md-10">
                    <div class="col-md-4" style="border: 2px solid #d7d5d2 !important">
                        <div class="col-md-5">
                            @Html.DropDownList("IdKho", null, new { style = "width: 100%; height: 40px" })
                        </div>
                        <div class="col-md-7">
                            <select class="form-control" id="ChuyenKho" name="ChuyenKho" style="width: 100%; height: 40px; margin: 0 auto">
                                <option value="0">ChuyểnKho/Bán</option>
                                <option value="1">Chuyển Kho</option>
                                <option value="2">Bán</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        @Html.DropDownList("IdChiNhanh", null, new { style = "width: 70%; height: 40px" })
                    </div>
                    <div class="col-md-2">
                        <div class="col-md-3">
                            <span style="line-height:40px; font-size:30px">Id:</span>
                        </div>
                        <div class="col-md-9">
                            <input type="number" value="0" class="form-control input-sm" style="font-size: medium; height: 40px; width: 100%" name="Keywordsid" id="Keywordsid" placeholder="Tìm theo Id." />
                        </div>
                    </div>
                    <div class="col-md-2" style="text-align:right">
                        <a onclick="TimKiemsp()" class="btn btn-warning" style="text-align: right; height: 40px">Kiểm tra số S/N</a>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control input-sm" style="font-size: medium; height: 40px; width: 95%" name="KeywordsTT" id="KeywordsTT" placeholder="Tìm Số Serial box đang ở lô hàng nào ??." />

                    </div>

                </div>

            </div>

        </div>
        <div class="panel-body">
            @*<img id="loading" hidden src="~/Areas/Admin/Content/img/loading.gif" />*@
            <div class="listSNCN">


            </div>
        </div>
    </div>
</div>
<script>
    LoadChiNhanh()
    LoadKhoDi()
    LoadPage();
    function LoadPage() {
        Keywordsid = $("#Keywordsid").val();
        IdChiNhanh = $("#IdChiNhanh").val();
        chuyenkho = $("#ChuyenKho").val();
        idkho = $("#IdKho").val();
        $.ajax({
            url: "/Admin/ChiNhanh/GetListSNchinhanh",
            data: { id: Keywordsid, idchinhanh: IdChiNhanh, chuyenkho: chuyenkho, idkho: idkho },
            success: function (respone) {
                $(".listSNCN").html(respone);
            }
        });
    };
    function TimKiemsp() {
        var KeywordsTT = $("#KeywordsTT").val();
        if (KeywordsTT.trim().length > 0) {
            $.ajax({
                url: "/Admin/ChiNhanh/TimSNLoHang",
                data: { Serial: KeywordsTT },
                success: function (respone) {
                    location.reload();
                }
            });
        } else {
            alert("Bạn Chưa Điền Số S/N trên hộp để tìm !!!")
        }
    }
    $("#Keywordsid").change(function () {
        var Keywordsid = $("#Keywordsid").val();
        if (parseInt(Keywordsid) > 0) {
            $("#IdChiNhanh").prop("disabled", true);
            $("#ChuyenKho").prop("disabled", true);
            $("#IdKho").prop("disabled", true);
        } else {
            $('#IdChiNhanh').prop("disabled", false);
            $('#ChuyenKho').prop("disabled", false);
            $('#IdKho').prop("disabled", false);
        }
        LoadPage();
    });
    $("#IdChiNhanh").change(function () {
        IdChiNhanh = $("#IdChiNhanh").val();
        if (parseInt(IdChiNhanh) > 0) {
            $("#ChuyenKho").prop("disabled", true);
            $("#IdKho").prop("disabled", true);
        } else {
            $('#ChuyenKho').prop("disabled", false);
            $('#IdKho').prop("disabled", false);
        }
        LoadPage();
    });
    $("#ChuyenKho").change(function () {
        LoadPage();
    });
    $("#IdKho").change(function () {
        LoadPage();
    });
    function LoadChiNhanh() {
        $('#IdChiNhanh').empty();
        $.ajax({
            url: "/Admin/ChiNhanh/loadChiNhanh", // we are calling json method
            data: {},
            success: function (response) {
                $("#IdChiNhanh").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Nơi Đến")
                );
                $(response).each(function (i, e) {
                    $("#IdChiNhanh").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load ChiNhanh: ' + ex);
            }
        });

    };
    function LoadKhoDi() {
        $('#IdKho').empty();
        $.ajax({
            url: "/Admin/ChiNhanh/loadKhoDi", // we are calling json method
            data: {},
            success: function (response) {
                $("#IdKho").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Kho Xuất")
                );
                $(response).each(function (i, e) {
                    $("#IdKho").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load Kho: ' + ex);
            }
        });

    };
</script>

