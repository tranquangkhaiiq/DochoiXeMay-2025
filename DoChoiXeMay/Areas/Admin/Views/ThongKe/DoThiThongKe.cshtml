<style>
    .canvasjs-chart-credit {
        display: none;
    }
</style>
<input id="phantramdaban" value="@ViewBag.phantramdaban" hidden />
<input id="phantramTraHangLeLoi" value="@ViewBag.phantramTraHangLeLoi" hidden />
<input id="phantramTongtraBH" value="@ViewBag.phantramTongtraBH" hidden />
@*<input id="phantramTonkho" value="@ViewBag.phantramTonkho" hidden />*@
<input id="phantramTonkhoT" value="@ViewBag.phantramTonkhoT" hidden />
<input id="phantramTonkhoK" value="@ViewBag.phantramTonkhoK" hidden />
<input id="phantramMauDaXuat" value="@ViewBag.phantramMauDaXuat" hidden />

<input id="daban" value="@Session["daban"].ToString()" hidden />
<input id="TongtraBH" value="@Session["TongtraBH"].ToString()" hidden />
<input id="DaTraHangKhachLeLoi" value="@Session["DaTraHangKhachLeLoi"].ToString()" hidden />
@*<input id="TonKhoXiNhanGen1Tek" value="@Session["TonKhoXiNhanGen1Tek"].ToString()" hidden />*@
<input id="TonKhoXiNhanGen1TekT" value="@Session["TonKhoXiNhanGen1TekT"].ToString()" hidden />
<input id="TonKhoXiNhanGen1TekK" value="@Session["TonKhoXiNhanGen1TekK"].ToString()" hidden />
<input id="MauDaXuat" value="@Session["MauDaXuat"].ToString()" hidden />

@*27 tháng 11*@
<input id="TrongDaBanTikTok" value="@Session["TrongDaBanTikTok"].ToString()" hidden />
<input id="trongDaBanShopee" value="@Session["trongDaBanShopee"].ToString()" hidden />
<input id="trongDaBanLeNSan" value="@Session["trongDaBanLeNSan"].ToString()" hidden />
<input id="trongDaBanLSiNSan" value="@Session["trongDaBanLSiNSan"].ToString()" hidden />

<input id="KhoiDaBanTikTok" value="@Session["KhoiDaBanTikTok"].ToString()" hidden />
<input id="KhoiDaBanShopee" value="@Session["KhoiDaBanShopee"].ToString()" hidden />
<input id="KhoiDaBanLSiNSan" value="@Session["KhoiDaBanLSiNSan"].ToString()" hidden />
<input id="KhoiDaBanLeNSan" value="@Session["KhoiDaBanLeNSan"].ToString()" hidden />

<div id="chartContainer" style="height: 300px; width: 100%;"></div>
<div id="chartContainer3" style="height: 300px; width: 100%;margin-top:20px"></div>
<script>
    window.onload = function () {
        const Cdaban = $("#daban").val()
        const CTongtraBH = $("#TongtraBH").val()
        const CDaTraHangKhachLeLoi = $("#DaTraHangKhachLeLoi").val()
        //const CTonKhoXiNhanGen1Tek = $("#TonKhoXiNhanGen1Tek").val()
        const CTonKhoXiNhanGen1TekT = $("#TonKhoXiNhanGen1TekT").val()
        const CTonKhoXiNhanGen1TekK = $("#TonKhoXiNhanGen1TekK").val()
        const CMauDaXuat = $("#MauDaXuat").val()

        const daban = $("#phantramdaban").val().replace(',', '.')
        const tdaban = parseFloat(daban).toFixed(2);
        var TraHangLeLoi = $("#phantramTraHangLeLoi").val().replace(',', '.')
        var tTraHangLeLoi = parseFloat(TraHangLeLoi)
        var traBH = $("#phantramTongtraBH").val().replace(',', '.')
        var ttraBH = parseFloat(traBH)
        //var Tonkho = $("#phantramTonkho").val().replace(',', '.')
        //var tTonkho = parseFloat(Tonkho)
        var TonkhoT = $("#phantramTonkhoT").val().replace(',', '.')
        var tTonkhoT = parseFloat(TonkhoT)
        var TonkhoK = $("#phantramTonkhoK").val().replace(',', '.')
        var tTonkhoK = parseFloat(TonkhoK)
        var MauDaXuat = $("#phantramMauDaXuat").val().replace(',', '.')
        var tMauDaXuat = parseFloat(MauDaXuat)

        var chart = new CanvasJS.Chart("chartContainer", {
            animationEnabled: true,
            title: {
                text: "Xi Nhan Wave TNT BLOCKX G2 ZEN 1"
            },
            data: [{
                type: "pie",
                startAngle: 240,
                yValueFormatString: "##0.00\"%\"",
                indexLabel: "{label} {y}",
                dataPoints: [
                    { y: tdaban, label: "Da Ban (" + Cdaban + ")" },
                    { y: tTraHangLeLoi, label: "KhachLeTraHangLoi (" + CDaTraHangKhachLeLoi + ")" },
                    { y: ttraBH, label: "Tra BH KhachLe (" + CTongtraBH + ")" },
                    //{ y: tTonkho, label: "Ton kho (" + CTonKhoXiNhanGen1Tek + ")" },
                    { y: tTonkhoT, label: "Tonkho Trong (" + CTonKhoXiNhanGen1TekT + ")" },
                    { y: tTonkhoK, label: "Tonkho Khói (" + CTonKhoXiNhanGen1TekK + ")" },
                    { y: tMauDaXuat, label: "Hang Mau (" + CMauDaXuat + ")" }
                ]
            }]
        });
        chart.render();

        const trongTikTok = $("#TrongDaBanTikTok").val()
        var ttrongTikTok = parseInt(trongTikTok);
        const trongShopee = $("#trongDaBanShopee").val()
        var ttrongShopee = parseInt(trongShopee);
        const trongLeNSan = $("#trongDaBanLeNSan").val()
        var ttrongLeNSan = parseInt(trongLeNSan);
        const trongSiNSan = $("#trongDaBanLSiNSan").val()
        var ttrongSiNSan = parseInt(trongSiNSan);

        const khoiTikTok = $("#KhoiDaBanTikTok").val()
        var tkhoiTikTok = parseInt(khoiTikTok);
        const khoiShopee = $("#KhoiDaBanShopee").val()
        var tkhoiShopee = parseInt(khoiShopee);
        const khoiSiNSan = $("#KhoiDaBanLSiNSan").val()
        var tkhoiSiNSan = parseInt(khoiSiNSan);
        const khoiLeNSan = $("#KhoiDaBanLeNSan").val()
        var tkhoiLeNSan = parseInt(khoiLeNSan);

        var chart3 = new CanvasJS.Chart("chartContainer3", {
            exportEnabled: true,
            animationEnabled: true,
            title: {
                text: "TNT BLOCKX G2 ZEN 1 Da Ban"
            },
            subtitles: [{
                text: "Trong: Blue  -  Khoi: Red"
            }],
            axisX: {
                title: ""
            },
            axisY: {
                title: "ZEN 1 - Trong",
                titleFontColor: "#4F81BC",
                lineColor: "#4F81BC",
                labelFontColor: "#4F81BC",
                tickColor: "#4F81BC",
                includeZero: true
            },
            axisY2: {
                title: "ZEN 1 - Khoi",
                titleFontColor: "#C0504E",
                lineColor: "#C0504E",
                labelFontColor: "#C0504E",
                tickColor: "#C0504E",
                includeZero: true
            },
            toolTip: {
                shared: true
            },
            legend: {
                cursor: "pointer",
                itemclick: toggleDataSeries
            },
            data: [{
                type: "column",
                name: "Trong",
                showInLegend: true,
                yValueFormatString: "#,##0.#",
                dataPoints: [
                    { label: "LeNSan", y: ttrongLeNSan },

                    { label: "Shopee", y: ttrongShopee },
                    { label: "TikTok", y: ttrongTikTok },
                    { label: "SiNSan", y: ttrongSiNSan },
                    //{ label: "Massachusetts", y: 28234 }
                ]
            },
            {
                type: "column",
                name: "Khoi",
                //axisYType: "secondary",
                showInLegend: true,
                yValueFormatString: "#,##0.#",
                dataPoints: [
                    { label: "LeNSan", y: tkhoiLeNSan },

                    { label: "Shopee", y: tkhoiShopee },
                    { label: "TikTok", y: tkhoiTikTok },
                    { label: "SiNSan", y: tkhoiSiNSan },
                    //{ label: "Massachusetts", y: 528 }
                ]
            }]
        });
        chart3.render();

        function toggleDataSeries(e) {
            if (typeof (e.dataSeries.visible) === "undefined" || e.dataSeries.visible) {
                e.dataSeries.visible = false;
            } else {
                e.dataSeries.visible = true;
            }
            e.chart3.render();
        }
    }
</script>
