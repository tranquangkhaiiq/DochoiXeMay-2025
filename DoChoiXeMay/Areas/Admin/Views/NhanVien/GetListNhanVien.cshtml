@using DoChoiXeMay.Models;
<div class="table-responsive">
    <table class="table table-hover table-striped" style="margin-bottom:0">
        <thead>
            <tr class="canhgiua" style="background-color: #00bcd4">
                <th class="canhgiua" style="width: 10px; padding-left: 0; padding-right: 0">STT</th>
                @*<th class="canhgiua" style="width:10px">GioiTinh</th>*@
                <th class="canhgiua" style="padding-left: 0; padding-right: 0">HDaiDien</th>
                <th class="canhgiua">GioiTinh</th>
                <th class="canhgiua" style="width:100px">Tên NV</th>
                <th class="canhgiua">NgaySinh</th>
                <th class="canhgiua">CanCuocCongDan</th>
                <th class="canhgiua">DiaChiThuongTru</th>
                <th class="canhgiua">DiaChiHienTai</th>

                <th class="canhgiua">Bank</th>
                <th class="canhgiua">BangCapChinh</th>
                <th class="canhgiua">Vị Trí</th>
                <th class="canhgiua">ThuViec</th>
                <th class="canhgiua">Nghỉ Việc</th>

                <th class="canhgiua" style="width:10px">CCCD1</th>
                <th class="canhgiua" style="width:10px">CCCD2</th>
                <th class="canhgiua" style="width:10px">User</th>
                <th class="canhgiua" style="width:10px">Pass</th>
                <th class="canhgiua">Ngày Vào Cty</th>
                @if (Session["quyen"].ToString() == "1")
                {
                    <th class="canhgiua" style="width:120px">Sửa/Xóa</th>
                }

            </tr>
        </thead>
        <tbody style="border: 2px solid black !important">
            @foreach (DoChoiXeMay.Models.NV_NhanVienTek Item in ViewBag.GetListNV)
            {
                UserTek User = new UserTek();
                var PassCk = "";
                if (Item.IdUser != 0)
                {
                    var Udata = new DoChoiXeMay.Areas.Admin.Data.UserData();
                    User = Udata.GetUserbyID(Item.IdUser);
                    PassCk = Udata.PassbyPass(User.Id);
                }
                <tr class="canhgiua" style="border: 2px solid black !important">
                    <td>
                        @Item.STT
                    </td>
                    @if (Item.HinhDaiDien == null || Item.HinhDaiDien.Trim() == "")
                    {
                        if (Item.GioiTinh == false)
                        {
                            <td><img src="~/Content/imgTeK/Tocdai.png" alt="" class="avatartek" /></td>
                        }
                        else
                        {
                            <td><img src="~/Content/imgTeK/Namn.png" alt="" class="avatartek" /></td>
                        }
                    }
                    else
                    {
                        <td><img src="~/Content/imgTeK/@Item.HinhDaiDien" alt="" class="avatartek" /></td>
                    }

                    <td>
                        @if (Item.GioiTinh == false)
                        {
                            <span>Nữ</span>
                        }
                        else
                        {
                            <span>Nam</span>
                        }
                    </td>
                    <td>
                        @Item.HoTen
                    </td>
                    <td>
                        @Html.FormatValue(Item.NgayUpdate, "{0:dd/MM/yyyy}")
                    </td>
                    <td style="font-size:15px">
                        @Item.CCCD
                    </td>

                    <td style="font-size:15px">
                        @Item.DiaChiThuongTru
                    </td>
                    <td>
                        @Item.DiaChiHienTai
                    </td>
                    <td>
                        @Item.CongViec
                    </td>
                    <td>
                        @Item.BangCapChinh
                    </td>
                    <td>
                        @Item.NV_Vitrinhanvien.TenVitri
                    </td>
                    <td>
                        @if (Item.ThuViec)
                        {
                            <span style="background-color:burlywood">@Item.ThuViec</span>
                        }
                        else
                        {
                            <span>@Item.ThuViec</span>
                        }
                    </td>
                    <td>
                        @if (Item.DaNghiViec)
                        {
                            <span style="background-color:burlywood">@Item.DaNghiViec</span>
                        }
                        else
                        {
                            <span>@Item.DaNghiViec</span>
                        }
                    </td>
                    <td>
                        @if (File.Exists(Request.MapPath("~/Content/imgTeK/" + Item.HinhCanCuocTruoc)))
                        {
                            <a target="_blank" href="~/Content/imgTeK/@Item.HinhCanCuocTruoc">
                                <i class="glyphicon glyphicon-download-alt"></i>
                            </a>
                        }
                    </td>
                    <td style="border-right: 2px solid black !important">
                        @if (File.Exists(Request.MapPath("~/Content/imgTeK/" + Item.HinhCanCuocSau)))
                        {
                            <a target="_blank" href="~/Content/imgTeK/@Item.HinhCanCuocSau">
                                <i class="glyphicon glyphicon-download-alt"></i>
                            </a>
                        }
                    </td>
                    <td>
                        @User.UserName
                    </td>
                    <td>
                        @PassCk
                    </td>
                    <td>
                        @Html.FormatValue(Item.NgayTao, "{0:dd/MM/yyyy}")
                    </td>
                    @if (Session["quyen"].ToString() == "1")
                    {
                        <td>
                            <a class="btn btn-danger" href="/Admin/NhanVien/UpdateNhanVien/@Item.Id"><span class="glyphicon glyphicon-edit"></span></a>
                            <a style="display:none" class="btn btn-warning" onclick="return confirm('Bạn muốn xóa NV: '+@Item.HoTen+'??')" href="/Admin/NhanVien/DeleteNhanVien/@Item.Id"><span class="glyphicon glyphicon-trash"></span></a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

</div>
