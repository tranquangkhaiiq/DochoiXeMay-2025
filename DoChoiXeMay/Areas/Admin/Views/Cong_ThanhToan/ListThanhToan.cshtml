
@{
    ViewBag.Title = "ListThanhToan";
    Layout = "~/Areas/Admin/Views/Shared/_Layoutadmin.cshtml";
}

<script src="~/Areas/Admin/Content/jquery2.0.3.min.js"></script>
<style>
    .canhgiua {
        text-align: center !important;
    }
</style>
<div class="row">
    <div class="Title_Notin" style="text-align:center">
        <span>Thanh Toán Lương NV TeK</span>
    </div>
</div>
<div class="panel panel-default" style="margin-top:10px">
    <div class="panel-heading">
        <div class="row">
            <div class="pull-right label label-warning" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongBaoThanhToanTEKLoi"]
            </div>
            <div class="pull-right label label-success" style="margin-bottom: 5px; color: white; font-family: monospace; font-weight: bold; font-size: large">
                @Session["ThongBaoThanhToanTEK"]
            </div>
            <div class="row" style="margin-top:20px">
                <div class="col-lg-6 col-xl-6 col-md-4 col-sm-12 col-12">
                    <input style="margin-left: 10px; margin-bottom: 10px" type="month" name="ThangNam" value="@DateTime.Now.ToString("yyyy-MM")" id="ThangNam" />
                </div>
                <div class="col-lg-6 col-xl-6 col-md-4 col-sm-12 col-12">
                    @Html.DropDownList("IdNhanVien", null, new { style = "width: 70%; height: 30px" })
                </div>
            </div>
            
        </div>
    </div>
    <div class="panel-body">
        <img id="loading" hidden src="~/Areas/Admin/Content/img/loading.gif" />
        <div class="listThanhToan">


        </div>
    </div>
    <div class="panel-footer">

        <div class="row">
            <div class="col-md-8">
                <span class="TongSanPham"></span>
            </div>
            <div class="col-md-4" style="text-align: right">
                <span class="TongSanPham"></span>
            </div>
        </div>
        <div class="row">
            <h5>**Nhân viên partime, sau khi chấm công, mới có "Thanh Toán Lương"</h5>
        </div>
        @*<ul class="pager">
            <li><a href="#"><span class="glyphicon glyphicon-step-backward"></span></a></li>
            <li><a href="#"><span class="glyphicon glyphicon-chevron-left"></span></a></li>
            <li><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></li>
            <li><a href="#"><span class="glyphicon glyphicon-step-forward"></span></a></li>
        </ul>*@

    </div>
</div>
<script>
    LoadNhanVienThanhToan();
    var tn = $('#ThangNam').val();
    var NV = $("#IdNhanVien").val();
    LoadPage(tn,NV);
    function LoadPage(tn,NV) {
        $.ajax({
            url: "/Admin/Cong_ThanhToan/GetListThanhToan",
            data: { dtInput: tn, idnv: NV},
            success: function (respone) {
                $(".listThanhToan").html(respone);
                //var pagesp = pageNo + 1;
                //$('.TongSanPham').html(pagesp + '/' + TongSP + ' trang');
            }
        });
    };
    $("#ThangNam").change(function () {
        var NV = $("#IdNhanVien").val();
        var tn = $('#ThangNam').val();
        LoadPage(tn,NV)
    });
    $("#IdNhanVien").change(function () {
        var NV = $("#IdNhanVien").val();
        var tn = $('#ThangNam').val();
        LoadPage(tn,NV)
    });
    function LoadNhanVienThanhToan() {
        $('#IdNhanVien').empty();
        $.ajax({
            url: "/Admin/Cong_ThanhToan/NhanVienThanhToan", // we are calling json method
            data: {},
            success: function (response) {
                $("#IdNhanVien").append(
                    $('<option/>')
                        .attr('value', 0)
                        .text("Chọn NV")
                );
                $(response).each(function (i, e) {
                    $("#IdNhanVien").append(
                        $('<option/>')
                            .attr('value', e.id)
                            .text(e.ten)
                    );
                    // here we are adding option for Hãng
                });
            },
            error: function (ex) {
                alert('Lỗi load httc: ' + ex);
            }
        });

    };
</script>

