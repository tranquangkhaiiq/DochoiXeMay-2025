@using DoChoiXeMay.Models;
@model IEnumerable<Ser_XuatSN_CN>
<style>
    .tomau {
        background-color: darkkhaki;
    }
    .canhgiua {
        text-align: center !important;
    }
</style>
<div class="table-responsive">
    <table class="table table-hover table-striped" style="margin-bottom:0">
        <thead>
            <tr class="canhgiua" style="background-color: #00bcd4">
                <th class="canhgiua">Id</th>
                <th class="canhgiua">UserName</th>
                <th class="canhgiua">Kho</th>
                <th class="canhgiua">ChuyenKho</th>
                <th class="canhgiua">Kỳ Xuất</th>
                <th class="canhgiua">Chi Nhánh</th>
                <th class="canhgiua">SoLuong</th>
                <th class="canhgiua">Đã Add</th>
                <th class="canhgiua">Ghi Chú</th>
                <th class="canhgiua">Add Serial</th>
                @if (Session["quyen"] != null && int.Parse(Session["quyen"].ToString()) < 5)
                {
                    <th class="canhgiua">Update/Delete</th>
                }
                else
                {
                    <th class="canhgiua">Ngày Xuất</th>
                }
            </tr>
        </thead>
        @if (Model != null)
        {
            Model1 dbc = new Model1();
            <tbody style="border: 2px solid black !important">
                @foreach (DoChoiXeMay.Models.Ser_XuatSN_CN Item in ViewBag.GetListSNchinhanh)
                {
                    var cl = "";
                    if (Item.ChuyenKho == true)
                    {
                        cl = "tomau";
                    }
                    else
                    {
                        cl = "";
                    }
                    var kho = Item.KyXuatNhap.Kho.TenKho;
                    UserTek User = new UserTek();
                    if (Item.UserId != 0)
                    {
                        var Udata = new DoChoiXeMay.Areas.Admin.Data.UserData();
                        User = Udata.GetUserbyID(Item.UserId);
                    }
                    <tr class="canhgiua" style="border-bottom: 2px solid black !important">
                        <td>@Item.Id</td>
                        <td>@User.UserName</td>
                        <td>@kho</td>
                        <td class="@cl">@Item.ChuyenKho</td>
                        <td>
                            @Item.KyXuatNhap.TenKy
                        </td>
                        <td>
                            @if (Item.IdChiNhanh == 1)
                            {
                                <span>Kho</span>
                            }
                            else
                            {
                                <span>@Item.Ser_ChiNhanh.TenChiNhanh</span>
                            }
                        </td>
                        <td>@Item.SoLuong</td>
                        <td>@Item.DaAdd</td>
                        <td>
                            @Item.Ghichu
                        </td>
                        <td>
                            @if ((Item.SoLuong > 0 && Item.IdKyxuat > 1 && Item.IdChiNhanh > 1 && Item.ChuyenKho == false) ||
                                (Item.SoLuong > 0 && Item.IdKyxuat > 1 && Item.Ser_ChiNhanh.IdLevel == 10 && Item.ChuyenKho == true && Item.KyXuatNhap.IdKho != Item.DenKhoId))
                            {
                                <a style="cursor:pointer" href="/Admin/ChiNhanh/AddSN_ChiNhanh/@Item.Id">Xem và add S/N</a>
                            }
                            else
                            {
                                <a onclick="return confirm('Bạn phải update số lượng, kỳ xuất nhập và Chi Nhánh. Nếu ChuyenKho thì 2 kho phải khác nhau !!.')">Xem và add S/N</a>
                            }
                        </td>
                        <td>
                            @if (Session["quyen"] != null && int.Parse(Session["quyen"].ToString()) < 5)
                            {
                                <a class="btn btn-danger" href="/Admin/ChiNhanh/UpdateSNchoCN/@Item.Id"><span class="glyphicon glyphicon-edit"></span></a>
                                if (Session["quyen"].ToString() == "1")
                                {
                                    <a style="" class="btn btn-warning" onclick="return confirm('Bạn muốn xóa đợt xuất S/N cho Chi Nhánh: @Item.Ser_ChiNhanh.TenChiNhanh ??')" href="/Admin/ChiNhanh/DeleteSNChiNhanh/@Item.Id"><span class="glyphicon glyphicon-trash"></span></a>
                                }
                            }
                            else
                            {
                                <span>@Html.FormatValue(Item.NgayXuat, "{0:dd/MM/yyyy}")</span> 
                            }
                            </td>
                        </tr>

                }
            </tbody>
            <tfoot>

                <tr class="canhgiua">
                    <td colspan="3" style="color:chocolate">
                        Tổng Số Đơn: @ViewBag.TongSDong
                    </td>
                    <td colspan="6" style="color:chocolate">
                        Tổng SoLuong: @ViewBag.TongSL
                    </td>
                    <td colspan="3" style="color:mediumblue">
                    </td>
                </tr>
            </tfoot>
                }
        </table>

</div>
